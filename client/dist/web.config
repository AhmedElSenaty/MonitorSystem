<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="React Routes" stopProcessing="true">
          <!-- catch ALL incoming URLs -->
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- unless they map to an existing file -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- or an existing directory -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- rewrite to your root index.html -->
          <action type="Rewrite" url="/HU-FingerPrint/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- ensure static files (JS/CSS/images) are served -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
